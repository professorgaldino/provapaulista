rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /resultados/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['nome','turma','serie','disciplina','pontos','total','percentual','acertos','questoes','uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 50
        && request.resource.data.turma in ['7B','7C','8B','8C','9B','9C']
        && request.resource.data.pontos is int && request.resource.data.pontos >= 0 && request.resource.data.pontos <= 1000
        && request.resource.data.acertos is int && request.resource.data.acertos >= 0 && request.resource.data.acertos <= 10;
      allow update, delete: if false;
    }
  }
}
